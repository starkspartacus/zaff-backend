# Port de l'API (le frontend pointe sur http://localhost:8000/api)
PORT=8000

# MongoDB (sans nom de base : la base globale et les bases par établissement sont ajoutées automatiquement)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
GLOBAL_DATABASE_NAME=zaff_global

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
