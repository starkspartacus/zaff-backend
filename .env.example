# Copier ce fichier en .env et renseigner les valeurs. Le fichier .env n'est JAMAIS commité.
NODE_ENV=development

# Port de l'API (le frontend pointe sur http://localhost:8000/api)
PORT=8000

# MongoDB : URI du cluster SANS nom de base (la base globale et une base par boutique sont ajoutées automatiquement)
# Atlas : Database > Connect > Drivers. Exemple : mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net
MONGODB_URI=
GLOBAL_DATABASE_NAME=zaff_global

# JWT : clé de signature des sessions (32 caractères minimum en production)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Notifications push sur téléphone (facultatif) : générer une paire avec `npm run vapid:generate`
# La clé publique est transmise au navigateur par l'API (GET /api/notifications/push/config)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.com

# Photos / vidéos produits sur UploadThing (recommandé en production) : Dashboard UploadThing > API Keys > onglet V7.
# Sans jeton, les photos sont stockées dans MongoDB (pratique en local, déconseillé à grande échelle).
UPLOADTHING_TOKEN=

# Espace administrateur de la plateforme ZAFF (/admin) : catalogue global des appareils et de leurs photos.
# Sans ces deux valeurs, l'espace admin est fermé. Mot de passe : 12 caractères minimum en production,
# en clair ou en empreinte bcrypt (générer : node -e "console.log(require('bcrypt').hashSync('mot-de-passe', 12))").
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Recherche automatique des photos d'appareils par l'IA (espace admin > « Photos par l'IA ») : Google Gemini.
# Clé : https://aistudio.google.com/apikey (ne jamais la commiter). Sans clé, l'outil est simplement désactivé.
GEMINI_API_KEY=
# Modèle utilisé (vision + recherche Google) ; par défaut gemini-3.8-flash. Si Google retire un modèle, ZAFF passe
# automatiquement au modèle qu'il conseille (et l'indique dans les journaux) : reportez-le ici.
GEMINI_MODEL=
